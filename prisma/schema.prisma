// Esquema de base de datos del marketplace
// Local: SQLite. Produccion: cambia provider a "postgresql" y usa DATABASE_URL de Supabase/Neon.
// Nota: SQLite no soporta enums nativos en Prisma, por eso los roles y estados
// se guardan como texto (String) en vez de "enum". El valor siempre es uno de
// los indicados en el comentario de cada campo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nombre        String
  telefono      String?
  role          String   // "CLIENTE" | "PROVEEDOR" | "ADMIN" | "EQUIPO" (EQUIPO = acceso al CRM interno)
  ciudad        String?
  pais          String   @default("Colombia")
  createdAt     DateTime @default(now())

  // Recuperacion de contraseña: token de un solo uso + fecha de expiracion.
  // Se generan al pedir "olvide mi contraseña" y se borran (vuelven a null)
  // en cuanto se usan o vencen.
  resetToken         String?   @unique
  resetTokenExpiraEn DateTime?

  proveedor     Proveedor?
  solicitudes   Solicitud[]
  transacciones Transaccion[]
  resenasHechas Resena[]      @relation("ResenasHechas")
  reportesHechos Reporte[]

  // CRM interno (equipo de Chaski, no relacionado a clientes/proveedores
  // del marketplace).
  crmContactosPropios CrmContacto[]
  crmActividades      CrmActividad[]
}

model Categoria {
  id          String       @id @default(cuid())
  nombre      String       @unique
  slug        String       @unique
  icono       String       @default("🔧")
  proveedores Proveedor[]
  solicitudes Solicitud[]
}

model Proveedor {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  fotoUrl        String?  // foto de perfil, guardada como data URL base64
  aniosExperiencia Int?    @default(0)
  tarifaAproximada String? // monto en texto libre, ej. "50000" o "15-25"
  // Como cobra: "HORA" | "PROYECTO" | "MES"
  tarifaTipo       String  @default("PROYECTO")
  linkedinUrl    String?  // link opcional a LinkedIn; no implica verificacion real todavia
  portafolio     String?  // JSON de un array de proyectos: [{ titulo, descripcion?, imagenUrl }], max 6
  creditos       Int      @default(3) // creditos de bienvenida
  verificado     Boolean  @default(false)
  // Ruta (no URL publica) del documento de identidad subido para verificacion,
  // guardado en el bucket privado "verificaciones" de Supabase Storage.
  documentoVerificacionPath String?
  // "SIN_ENVIAR" | "PENDIENTE" | "APROBADO" | "RECHAZADO"
  estadoVerificacion String @default("SIN_ENVIAR")
  calificacionProm Float  @default(0)
  totalResenas   Int      @default(0)
  codigoReferido String?  @unique // link de invitacion propio de este proveedor
  referidoPorId  String?
  referidoPor    Proveedor?  @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos      Proveedor[] @relation("Referidos")
  createdAt      DateTime @default(now())

  categorias     Categoria[]
  desbloqueos    Desbloqueo[]
  resenasRecibidas Resena[]
}

model Solicitud {
  id           String          @id @default(cuid())
  clienteId    String
  cliente      User            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  categoriaId  String
  categoria    Categoria       @relation(fields: [categoriaId], references: [id])
  titulo       String
  descripcion  String
  ciudad       String
  presupuesto  String?
  // Moneda del presupuesto: "COP" | "USD" | "EUR"
  presupuestoMoneda String @default("COP")
  telefonoContacto String
  // Como prefiere el cliente que lo contacten: "TELEFONO" | "CORREO" | "AMBOS"
  preferenciaContacto String @default("AMBOS")
  estado       String          @default("ABIERTA") // "ABIERTA" | "CERRADA"
  createdAt    DateTime        @default(now())

  desbloqueos  Desbloqueo[]
}

// Cuando un proveedor gasta creditos para ver el contacto de una solicitud
model Desbloqueo {
  id           String    @id @default(cuid())
  proveedorId  String
  proveedor    Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  solicitudId  String
  solicitud    Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  creditosUsados Int     @default(1)
  createdAt    DateTime  @default(now())

  @@unique([proveedorId, solicitudId])
}

model PaqueteCreditos {
  id        String   @id @default(cuid())
  nombre    String
  creditos  Int
  precioCOP Int
  activo    Boolean  @default(true)
}

model Transaccion {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditos      Int
  montoCOP      Int
  estado        String            @default("PENDIENTE") // "PENDIENTE" | "APROBADA" | "RECHAZADA"
  mpPaymentId   String?
  mpPreferenceId String?
  createdAt     DateTime          @default(now())
}

model Resena {
  id          String    @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User      @relation("ResenasHechas", fields: [autorId], references: [id], onDelete: Cascade)
  puntuacion  Int
  comentario  String?
  createdAt   DateTime  @default(now())

  @@unique([proveedorId, autorId])
}

// Reporte de un perfil o solicitud sospechosa (ej. datos falsos, pide pagos
// fuera de la plataforma, comportamiento abusivo). No tiene relacion directa
// a Proveedor/Solicitud por FK para mantener el modelo simple: "objetivoId"
// guarda el id del perfil o de la solicitud reportada segun "tipo".
model Reporte {
  id             String   @id @default(cuid())
  tipo           String   // "PERFIL" | "SOLICITUD"
  objetivoId     String
  reporterUserId String
  reporterUser   User     @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  motivo         String
  estado         String   @default("PENDIENTE") // "PENDIENTE" | "REVISADO"
  createdAt      DateTime @default(now())
}

// Interesados de EE.UU. captados en la landing en ingles (/en), antes de
// construir el flujo completo bilingue. Se contactan manualmente.
model LeadUS {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  empresa   String?
  mensaje   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------
// CRM interno de Chaski (equipo de ventas/outreach). No tiene relacion
// con los clientes/proveedores del marketplace: es para llevar el
// seguimiento de las empresas y personas con las que el equipo de
// Chaski esta hablando para que usen la plataforma.
// ---------------------------------------------------------------------

model CrmEmpresa {
  id        String   @id @default(cuid())
  nombre    String
  sitioWeb  String?
  notas     String?
  createdAt DateTime @default(now())

  contactos CrmContacto[]
}

model CrmContacto {
  id        String      @id @default(cuid())
  nombre    String
  email     String?
  telefono  String?
  empresaId String?
  empresa   CrmEmpresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  // Etapa del pipeline: "NUEVO" | "CONTACTADO" | "NEGOCIANDO" | "GANADO" | "PERDIDO"
  etapa  String  @default("NUEVO")
  origen String? // de donde salio el lead, ej. "LinkedIn", "Referido", "Reddit"
  notas  String?

  propietarioId String?
  propietario   User?   @relation(fields: [propietarioId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tareas      CrmTarea[]
  actividades CrmActividad[]
}

model CrmTarea {
  id          String      @id @default(cuid())
  contactoId  String
  contacto    CrmContacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  titulo      String
  fechaLimite DateTime?
  completada  Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

model CrmActividad {
  id         String      @id @default(cuid())
  contactoId String
  contacto   CrmContacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  // "NOTA" | "LLAMADA" | "CORREO" | "REUNION"
  tipo       String
  contenido  String
  autorId    String?
  autor      User?       @relation(fields: [autorId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
}

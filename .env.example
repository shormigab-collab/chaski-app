# Base de datos: en local usa SQLite (ya viene lista).
# En produccion, usa la URL de Postgres que te da Supabase o Neon.
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar sesiones (genera una larga y aleatoria)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales de Mercado Pago (las obtienes en https://www.mercadopago.com/developers/panel)
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx"

# URL publica de tu sitio (para los links de retorno de pago)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Clave de la API de Claude para el asistente de IA (la obtienes en https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"

# Resend: para enviar correos (ej. recuperar contraseña). La obtienes en
# https://resend.com/api-keys despues de crear tu cuenta.
RESEND_API_KEY="re_xxxxxxxx"

# Direccion "from" verificada en Resend. Mientras no verifiques el dominio
# usechaski.com en Resend, deja esta linea comentada y se usara la direccion
# de prueba gratuita de Resend automaticamente.
# RESEND_FROM_EMAIL="chaski <no-reply@usechaski.com>"

# A donde llegan los casos escalados desde el widget de chat de soporte
# (boton "Prefiero hablar con una persona"). Si no la configuras, cae por
# defecto en el correo de Sebas para que nada se pierda. Cambiala cuando
# tengas un buzon dedicado, ej. soporte@usechaski.com.
# SUPPORT_EMAIL="soporte@usechaski.com"
